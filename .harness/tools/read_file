#!/usr/bin/env bash
# read_file (repo-local shadow) — core read_file plus a `tag=XXXXXXXX`
# header line on successful reads: the whole-file snapshot tag that the
# incubating edit_file v2 (this dir) verifies before editing. Schema and
# describe pass through unchanged; errors pass through without a tag.
# Deleted when edit_file v2 swaps into plugins/core/tools/.
set -euo pipefail

_self="$0"; [[ -L "$_self" ]] && _self="$(readlink -f "$_self")"
_core="$(dirname "${_self}")/../../plugins/core/tools/read_file"
[[ -x "${_core}" ]] || { echo "error: core read_file not found at ${_core}"; exit 1; }

case "${1:-}" in
  --schema|--describe)
    exec "${_core}" "$@"
    ;;
  --exec)
    input="$(cat)"
    out="$(mktemp)"; trap 'rm -f "${out}"' EXIT
    if printf '%s' "${input}" | "${_core}" --exec > "${out}"; then
      path="$(echo "${input}" | jq -r '.path // empty')"
      [[ -n "${path}" && "${path}" != "null" ]] || path=""
      [[ "${path}" != /* && -n "${path}" ]] && path="${HARNESS_CWD:-${PWD}}/${path}"
      tag=""
      [[ -n "${path}" && -f "${path}" ]] && tag="$(md5sum "${path}" | cut -c1-8)"
      [[ -n "${tag}" ]] && echo "tag=${tag}"
      cat "${out}"
    else
      cat "${out}"
      exit 1
    fi
    ;;
  *)
    exec "${_core}" "$@"
    ;;
esac