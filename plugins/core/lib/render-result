#!/usr/bin/env bash
# render-result — human-readable rendering of tool results.
# A flat JSON object of scalars (e.g. the bash tool's {exit, elapsed_s,
# stdout, stderr, ...} envelope) is rendered as YAML: multi-line strings use
# block scalars so embedded newlines read as real lines, not \n escapes.
# Anything else passes through unchanged.
set -euo pipefail
jq -Rsr '
  def scalar($v):
    if ($v | type) == "string" then
      if ($v | test("\n")) then
        "|" + ($v | rtrimstr("\n") | split("\n") | map("\n  " + .) | join(""))
      elif ($v == "" or ($v | test("[\"\\\\#]")) or ($v | test("^ | $"))) then
        $v | tojson
      else $v end
    elif ($v | type) == "null" then "null"
    else $v | tostring end;

  . as $text
  | (try ($text | fromjson) catch null) as $doc
  | if ($doc | type) == "object" and ($doc | length) > 0
      and ($doc | [.[] | type] | all(. == "string" or . == "number" or . == "boolean" or . == "null"))
    then [$doc | to_entries[] | "\(.key): \(scalar(.value))"] | join("\n")
    else $text
    end'